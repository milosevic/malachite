      .then(proposal_evidence_add(1, 0, "64", -1, "c8", -1))
      .expect(evidence_from_two_validators)
      .then(proposal_evidence_add(0, 0, "64", -1, "c8", -1))
      .expect(proposal_evidence_deduped)

  /// @covered_by evidence::store_proposal_surfaces_equivocation_to_caller
  run storeProposalStoreProposalStoreProposalRecordProposalEvidence =
    init
      .then(store_proposal(0, 0, "64", -1, "Valid"))
      .then(store_proposal(0, 0, "64", -1, "Valid"))
      .then(store_proposal(0, 0, "c8", -1, "Valid"))
      .then(record_proposal_evidence(0, 0, "64", -1, "c8", -1))
      .then(proposal_evidence_add(0, 0, "64", -1, "c8", -1))
      .expect(proposal_equivocation_recorded)
      .then(read_proposal_evidence)

  /// @covered_by test_vote_evidence_deduplication
  run voteEvidenceAdd =
